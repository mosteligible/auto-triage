# Service
ENVIRONMENT=local
RUN_WORKER=true

# Postgres storage.
# docker compose uses POSTGRES_* to provision the database and configure the app.
POSTGRES_USER=auto_triage
POSTGRES_PASSWORD=auto_triage_password
POSTGRES_DB=auto_triage
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_PUBLISHED_PORT=5432

# Optional direct SQLAlchemy URL override. Leave empty to build the URL from POSTGRES_*.
DATABASE_URL=

# Redis cache.
# Redis uses an ACL username/password in docker compose.
REDIS_CACHE_ENABLED=true
REDIS_USERNAME=auto_triage
REDIS_PASSWORD=auto_triage_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=300

# Incoming Logfire webhook auth is currently disabled in the FastAPI route.

# Logfire query API.
# Use https://logfire-us.pydantic.dev or https://logfire-eu.pydantic.dev.
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
LOGFIRE_READ_TOKEN=
LOGFIRE_PROJECT_URL=
LOGFIRE_LOOKBACK_HOURS=2

# Pydantic AI / model providers.
# Logfire webhooks use Azure OpenAI by default. Add ?ai_provider=openai to use standard OpenAI.
# Manual triggers use standard OpenAI by default. Add ?ai_provider=azure to use Azure OpenAI.
OPENAI_API_KEY=
TRIAGE_MODEL=openai:gpt-4.1-mini
OPENAI_TRIAGE_MODEL=

# If the endpoint ends with /openai/v1, AZURE_OPENAI_API_VERSION is not required.
# For classic Azure OpenAI endpoints, set AZURE_OPENAI_API_VERSION.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# GitHub target repo, issue creation, and pull request creation.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_DEFAULT_BRANCH=main
TARGET_REPO_URL=https://github.com/owner/repo.git

# Runtime workspace for temporary clones.
# Relative paths are placed under /tmp/auto-triage-work to avoid Uvicorn --reload restarts.
WORKSPACE_DIR=.auto-triage-work
CLEANUP_REPO_AFTER_TRIAGE=true

# Optional test-app token for docker compose.
TEST_APP_LOGFIRE_TOKEN=
TEST_APP_LOGFIRE_SERVICE_NAME=test-app-failure-generator
TEST_APP_LOGFIRE_ENVIRONMENT=docker
